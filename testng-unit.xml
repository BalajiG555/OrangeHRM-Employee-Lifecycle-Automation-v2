<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Fast framework self-tests (no browser, no network). Run with:  mvn test -Dtestng.suite=testng-unit.xml -->
<suite name="Framework unit tests" verbose="1">
    <test name="Framework">
        <classes>
            <class name="com.framework.unit.ConfigReaderTest"/>
            <class name="com.framework.unit.TestDataGeneratorTest"/>
            <class name="com.framework.unit.FrameworkUtilitiesTest"/>
            <class name="com.framework.unit.FlakyDetectionTest"/>
            <class name="com.framework.unit.VideoEncoderTest"/>
        </classes>
    </test>
</suite>
